# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# Neon Object Storage (AWS S3-compatible)
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
AWS_ENDPOINT_URL_S3=https://...storage.neon.tech
AWS_REGION=us-east-2

# JWT secrets (generate strong random strings, e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins, or * for dev)
CORS_ORIGIN=*

# Test User Creation (for `npm run create-test-user`, min 8 chars)
TEST_USER_PASSWORD=your-test-user-password-here

